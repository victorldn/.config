bindsym $mod+m move workspace to output next
bindsym $mod+q floating toggle

# -------------------------------------------------------------------
# Application placement
# -------------------------------------------------------------------
#
# Window criteria can be inspected with:
#
#   xprop WM_CLASS
#
# Then click the application window.
#
# Example output:
#
#   WM_CLASS(STRING) = "Navigator", "firefox_firefox"
#
# The first value is the window instance.
# The second value is the window class.
#
# Example rule:
#
#   assign [class="(?i)^kitty$"] number 1
#
# Regular-expression components:
#
#   (?i)   case-insensitive matching
#   ^      start of the value
#   kitty  literal class name
#   $      end of the value
#
# Assignment rules apply when a new window is created. Existing windows
# are not moved when the configuration is reloaded.

# Assignment rules apply when a new window is created. Existing windows
# are not moved when the configuration is reloaded.

assign [class="(?i)^kitty$"] number 3
assign [class="(?i)^firefox_firefox$"] number 9
assign [class="(?i)^emacs$"] number 10
assign [class="(?i)^slack$"] number 8
assign [class="(?i)^thunderbird_thunderbird$"] number 8
assign [instance="(?i)^www.irccloud.com__irc_oftc_channel_gcc"] number 8
assign [class="(?i)^spotify$"] number 7
assign [class="(?i)^com.cisco.secureclient.gui$"] number 0

# -------------------------------------------------------------------
# Session startup
# -------------------------------------------------------------------
#
# The startup script checks whether each application is already running
# before launching it. This prevents duplicate applications if the
# script is executed more than once.
#
# Use exec_always so that restarting i3 restores any applications that
# are no longer running. The script's process checks prevent duplicates.

exec_always --no-startup-id ~/.config/regolith3/i3/start-apps.sh

# Start the Eww dashboard and its supporting scripts.
exec_always --no-startup-id ~/.config/eww/start.sh

# PolicyKit authentication agent.
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
