# ~/.config/dejagnu/boards/aarch64-ssh.exp
#
# Run AArch64/Linux executables on a remote machine over SSH.
#
# We deliberately use DejaGNU's "standard" remote machinery, but substitute
# ssh/scp for the historical rsh/rcp programs.  This avoids the quoting issue
# encountered in DejaGNU 1.6.x's native ssh_exec implementation.

load_generic_config "unix"

# This target is remote.
set_board_info isremote 1

# Use the standard remote protocol.
set_board_info protocol "standard"

# The standard transport normally uses rsh/rcp.  Substitute modern SSH tools.
set_board_info rsh_prog "/usr/bin/ssh"
set_board_info rcp_prog "/usr/bin/scp"

# This is the Host alias from ~/.ssh/config.
set_board_info hostname "aarch64-test"

# Ordinary Unix/Linux target.
set_board_info os_type "unix"
